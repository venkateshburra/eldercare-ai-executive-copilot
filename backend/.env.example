# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/eldercare_copilot

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret_at_least_64_chars
JWT_EXPIRES_IN=1d

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# NEVER expose this key in frontend code
GEMINI_API_KEY=your_gemini_api_key_here

# ── Frontend URL (CORS) ────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL=500
RATE_LIMIT_AUTH=30
RATE_LIMIT_AI=30

# ── Redis (optional — configure if using caching or background jobs) ──────────
# REDIS_URL=redis://127.0.0.1:6379
